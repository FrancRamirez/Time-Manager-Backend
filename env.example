# --- TiDB Cloud ---
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=time_manager

# --- Google OAuth (mismo proyecto de GCP que usa la app Android) ---
# Client ID de tipo "Web" (el mismo que EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID en la app)
GOOGLE_WEB_CLIENT_ID=
# Client secret del cliente Web (Google Cloud Console -> Credenciales -> ese cliente)
GOOGLE_WEB_CLIENT_SECRET=
# Opcional: Client ID de tipo "Android", para validar audiencia del idToken
GOOGLE_ANDROID_CLIENT_ID=

# --- Sesión propia (JWT) ---
# Generar con: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=7d
REFRESH_TOKEN_TTL=7d

# --- Cifrado de refresh tokens en DB (AES-256-GCM) ---
# Generar con: openssl rand -hex 32   (debe ser hex de 64 caracteres = 32 bytes)
TOKEN_ENCRYPTION_KEY=

# --- IA (Gemini) ---
# Key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcionales: el modelo se puede cambiar sin tocar código
GEMINI_MODEL=gemini-3.8-flash
# Respaldos de Gemini, separados por coma. En el plan gratuito la cuota diaria es POR MODELO: cada uno suma cupo.
# Termina en un Flash-Lite (más barato). Un id que no exista se omite solo. Confirma los ids vigentes en
# Google AI Studio (otro Lite documentado por Google: gemini-3.1-flash-lite).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite

# --- Proveedor alternativo (OPCIONAL) ---------------------------------------------------------
# Si Gemini no responde (saturado, sin cuota, timeout) el chat continúa con este otro servicio.
# Debe ser compatible con "chat completions" de OpenAI Y soportar function calling (Groq, Mistral,
# OpenRouter, Cerebras...). Se activa solo si están las TRES variables. Si está activo, la app deja de
# bloquear el chat cuando Gemini agota su cuota.
# OJO PRIVACIDAD: el chat envía correos y eventos del usuario. Revisa los términos del proveedor
# (los planes gratuitos suelen permitir usar los datos para entrenar) antes de activarlo.
AI_ALT_BASE_URL=
AI_ALT_API_KEY=
AI_ALT_MODEL=

# --- Barrido con la app cerrada y push (IDEA 4A; ver docs/SCHEDULER.md) ---
# Clave larga al azar (mínimo 16 caracteres) que el planificador externo envía como "Authorization: Bearer ...".
# Sin ella el endpoint /api/cron/scan queda cerrado.
CRON_SECRET=
# JSON de una cuenta de servicio de Firebase (tal cual o en base64). Sin él el barrido no analiza nada.
FIREBASE_SERVICE_ACCOUNT=

# --- Pronóstico (Open-Meteo) ---
# Vacío = servidores gratuitos (SOLO uso no comercial, con atribución). Para vender la app hay que contratar
# el plan de pago en https://open-meteo.com/en/pricing y pegar aquí la clave que entregan.
OPEN_METEO_API_KEY=

# --- Medición de tiempos (IDEA 4C; ver docs/PERFORMANCE.md) ---
# Una línea JSON por request en los logs de Vercel, sin datos del usuario. Pon 0 para apagarla.
PERF_LOG=1

# --- Cupo de mensajes de IA ---
# Mensajes por usuario y día (se renuevan a medianoche hora del Pacífico, igual que la cuota de Google).
# 0 = sin límite propio. Por defecto 10.
AI_DAILY_MESSAGES_PER_USER=10

# --- Google Maps (IDEA 1; ver docs/MAPS.md) ---
# Clave de API con "Places API (New)" y "Routes API" habilitadas. Sin ella Frami no busca lugares ni calcula
# tiempos de viaje, pero sí puede abrir la ruta en la app de Google Maps (eso no usa la API).
GOOGLE_MAPS_API_KEY=
# Opcional: código de región (CLDR, 2 letras) para priorizar resultados del país, p. ej. AR.
MAPS_REGION_CODE=
